<mxfile host="app.diagrams.net">
  <diagram id="travelmemory-architecture" name="TravelMemory AWS Architecture">
    <mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="TravelMemory | AWS Deployment Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#17212B;" vertex="1" parent="1"><mxGeometry x="60" y="35" width="900" height="50" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Two frontend instances, two backend instances, managed MongoDB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#62707C;" vertex="1" parent="1"><mxGeometry x="60" y="82" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="users" value="Users / Browser&#xa;HTTP requests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B9C4CE;strokeWidth=2;fontColor=#17212B;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="210" height="130" as="geometry" /></mxCell>
        <mxCell id="frontendAlb" value="Frontend ALB&#xa;travelmemory-frontend-alb&#xa;Listener: HTTP :80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDE6E5;strokeColor=#D83B40;strokeWidth=2;fontColor=#742126;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="260" width="270" height="130" as="geometry" /></mxCell>
        <mxCell id="frontendGroup" value="Target group: travelmemory-frontend-tg | HTTP :80 | Health check: /" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;dashed=1;dashPattern=8 4;fillColor=#F1F7FB;strokeColor=#6D9BB8;strokeWidth=2;fontColor=#284A60;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="710" y="200" width="830" height="250" as="geometry" /></mxCell>
        <mxCell id="frontend1" value="frontend-master&#xa;EC2 | Nginx :80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6D9BB8;strokeWidth=2;fontColor=#17212B;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="280" width="330" height="105" as="geometry" /></mxCell>
        <mxCell id="frontend2" value="frontend-2&#xa;EC2 | Nginx :80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6D9BB8;strokeWidth=2;fontColor=#17212B;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="280" width="330" height="105" as="geometry" /></mxCell>
        <mxCell id="backendAlb" value="Backend ALB&#xa;travelmemory-backend-alb&#xa;Listener: HTTP :80" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDE6E5;strokeColor=#D83B40;strokeWidth=2;fontColor=#742126;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="680" width="280" height="135" as="geometry" /></mxCell>
        <mxCell id="backendGroup" value="Target group: travelmemory-backend-tg | HTTP :80 | Health check: GET /health" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;dashed=1;dashPattern=8 4;fillColor=#F1F7FB;strokeColor=#6D9BB8;strokeWidth=2;fontColor=#284A60;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="650" y="600" width="580" height="260" as="geometry" /></mxCell>
        <mxCell id="backend1" value="backend-master&#xa;EC2 | Nginx :80 | Node.js :3000 via systemd" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6D9BB8;strokeWidth=2;fontColor=#17212B;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="670" width="500" height="75" as="geometry" /></mxCell>
        <mxCell id="backend2" value="backend-2 (from AMI)&#xa;EC2 | Nginx :80 | Node.js :3000 via systemd" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6D9BB8;strokeWidth=2;fontColor=#17212B;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="765" width="500" height="75" as="geometry" /></mxCell>
        <mxCell id="atlas" value="MongoDB Atlas&#xa;Application database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E4F5EA;strokeColor=#3A9A62;strokeWidth=2;fontColor=#1E5836;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="680" width="210" height="135" as="geometry" /></mxCell>
        <mxCell id="flow1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#536575;strokeWidth=2;fontSize=13;fontColor=#536575;" edge="1" parent="1" source="users" target="frontendAlb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow3" value="Distributes web traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#536575;strokeWidth=2;fontSize=13;fontColor=#536575;" edge="1" parent="1" source="frontendAlb" target="frontendGroup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="api1" value="API requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D83B40;strokeWidth=2;fontSize=14;fontColor=#A32930;" edge="1" parent="1" source="frontendGroup" target="backendAlb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="flow5" value="Distributes API traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#536575;strokeWidth=2;fontSize=13;fontColor=#536575;" edge="1" parent="1" source="backendAlb" target="backendGroup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="db1" value="MongoDB connection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A9A62;strokeWidth=2;fontSize=13;fontColor=#267344;" edge="1" parent="1" source="backend1" target="atlas"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="db2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A9A62;strokeWidth=2;" edge="1" parent="1" source="backend2" target="atlas"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="802" /><mxPoint x="1260" y="760" /></Array></mxGeometry></mxCell>
        <mxCell id="amiNote" value="Instances 2 launched from AMIs | Cloudflare is not used" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#62707C;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="890" width="550" height="28" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
